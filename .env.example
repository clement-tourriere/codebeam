# Copy this file to .env and fill the values you need.
# mise.toml loads .env automatically for `mise run dev`, `mise run build`, etc.

CODEBEAM_BASE_URL=http://localhost:8080
# CODEBEAM_ADDR=:8080
# CODEBEAM_SESSION_SECRET=dev-secret-change-me
# Passwordless dev login. Defaults on for a loopback CODEBEAM_BASE_URL, off for a real host.
# CODEBEAM_DEV_LOGIN=false

# Encryption at rest for stored code-host access tokens (identities.access_token).
# If unset, a random key is auto-generated on first run at
# <user config dir>/codebeam/encryption.key (0600, outside CODEBEAM_DATA_DIR) and
# reused on restart, so encryption is always on with no setup. In containers with
# no persistent volume for that file, set CODEBEAM_ENCRYPTION_KEY or mount a key
# file — otherwise a new key is generated each restart and existing tokens become
# unreadable. Generate a key with: openssl rand -base64 32
# CODEBEAM_ENCRYPTION_KEY=
# CODEBEAM_ENCRYPTION_KEY_FILE=/etc/codebeam/encryption.key

# GitHub OAuth app credentials (optional if you use a personal access token in the Sources UI).
# GitHub callback URL: http://localhost:8080/auth/github/callback
CODEBEAM_GITHUB_CLIENT_ID=
CODEBEAM_GITHUB_CLIENT_SECRET=

# GitLab OAuth app credentials (optional).
# GitLab callback URL: http://localhost:8080/auth/gitlab/callback
# Set CODEBEAM_GITLAB_BASE_URL to your self-managed GitLab URL for self-managed OAuth.
# CODEBEAM_GITLAB_BASE_URL=https://gitlab.com
CODEBEAM_GITLAB_CLIENT_ID=
CODEBEAM_GITLAB_CLIENT_SECRET=

# Optional storage/asset overrides.
# CODEBEAM_DATA_DIR=.codebeam
# CODEBEAM_DB_PATH=.codebeam/codebeam.db
# CODEBEAM_REPO_DIR=.codebeam/repos
# CODEBEAM_INDEX_DIR=.codebeam/index
# CODEBEAM_STATIC_DIR=static
# CODEBEAM_TEMPLATE_GLOB=templates/*.html

# Optional indexing/freshness overrides.
# CODEBEAM_WATCH_LOCAL_REPOS=true
# CODEBEAM_REMOTE_REFRESH_INTERVAL=30m
# CODEBEAM_AUTO_INDEX_REMOTE=true
# CODEBEAM_SYNC_PERMISSIONS=true
# CODEBEAM_PERMISSION_SYNC_INTERVAL=1h
# CODEBEAM_CTAGS_PATH=

# Optional OIDC SSO login (Okta, Entra ID, Google Workspace, Keycloak, ...).
# CODEBEAM_OIDC_ISSUER=https://your-tenant.okta.com
# CODEBEAM_OIDC_CLIENT_ID=...
# CODEBEAM_OIDC_CLIENT_SECRET=...
# CODEBEAM_OIDC_NAME=Okta
# CODEBEAM_OIDC_SCOPES=openid profile email
# CODEBEAM_OIDC_ALLOWED_DOMAINS=acme.com
